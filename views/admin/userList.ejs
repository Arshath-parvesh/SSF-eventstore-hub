<%- include('../partials/header') %>

<div class="card">
  <div class="card-header">
    <div>
      <h1 class="card-title">User Management</h1>
      <p style="font-size: 0.9rem; color: var(--color-mid-gray);">View user directory, toggle active/inactive status, and audit public identifiers</p>
    </div>
    <a href="/admin/users/create" class="btn btn-primary">+ Create User</a>
  </div>

  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>UserNo (Server ID)</th>
          <th>Username</th>
          <th>Email Address</th>
          <th>Unit Type</th>
          <th>State</th>
          <th>District</th>
          <th>Unit</th>
          <th>Role</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><strong style="color: var(--color-black);"><%= user.user_no %></strong></td>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
            <td><span class="badge badge-<%= user.unit_type %>"><%= user.unit_type %></span></td>
            <td><%= user.state_name || 'Tamil Nadu' %></td>
            <td><%= user.district_name || 'Chennai' %></td>
            <td><%= user.unit_name || 'Sholinganallur' %></td>
            <td>
              <% if (user.is_admin) { %>
                <span class="badge" style="background-color: var(--color-black); color: var(--color-white);">Admin</span>
              <% } else { %>
                <span style="color: var(--color-mid-gray); font-size: 0.85rem;">Standard</span>
              <% } %>
            </td>
            <td>
              <span class="badge badge-<%= user.status %>"><%= user.status %></span>
            </td>
            <td>
              <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <% if (user.user_no !== currentUser.user_no) { %>
                  <!-- Status Toggle -->
                  <form action="/admin/users/status" method="POST" style="display: inline;" data-no-loader="true">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="user_no" value="<%= user.user_no %>">
                    <input type="hidden" name="status" value="<%= user.status === 'active' ? 'inactive' : 'active' %>">
                    <button type="submit" class="btn <%= user.status === 'active' ? 'btn-danger' : 'btn-primary' %> btn-sm">
                      Set <%= user.status === 'active' ? 'Inactive' : 'Active' %>
                    </button>
                  </form>

                  <!-- Admin Role Toggle -->
                  <% if (user.username === 'admin') { %>
                    <span class="badge" style="background: var(--color-blue); color: var(--color-black); border: 1px solid rgba(0,0,0,0.15); font-weight: 700; padding: 0.35rem 0.6rem;" title="Primary admin user access cannot be revoked">
                      🔒 Protected
                    </span>
                  <% } else if (user.is_admin) { %>
                    <form action="/admin/users/role" method="POST" style="display: inline;" data-no-loader="true">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="user_no" value="<%= user.user_no %>">
                      <input type="hidden" name="is_admin" value="0">
                      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Revoke Admin privileges from <%= user.username %>?');">
                        Revoke Admin
                      </button>
                    </form>
                  <% } else { %>
                    <form action="/admin/users/role" method="POST" style="display: inline;" data-no-loader="true">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="user_no" value="<%= user.user_no %>">
                      <input type="hidden" name="is_admin" value="1">
                      <button type="submit" class="btn btn-outline btn-sm" onclick="return confirm('Grant Admin privileges to <%= user.username %>?');">
                        Grant Admin
                      </button>
                    </form>
                  <% } %>
                <% } else { %>
                  <span style="font-size: 0.75rem; color: var(--color-mid-gray); font-style: italic;">Current Session</span>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
