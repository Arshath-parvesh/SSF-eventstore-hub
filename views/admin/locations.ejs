<%- include('../partials/header') %>

<div class="card">
  <div class="card-header">
    <div>
      <h1 class="card-title">State, District & Unit Location Management</h1>
      <p style="font-size: 0.9rem; color: var(--color-mid-gray);">Super Admin panel to create and manage States, Districts, and Units for the system dropdowns</p>
    </div>
  </div>

  <!-- Forms Grid to Add State, District, and Unit -->
  <div class="form-row" style="margin-bottom: 2rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
    
    <!-- Add State Form -->
    <div style="background-color: var(--color-zumthor); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(0, 0, 0, 0.08);">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-black);">+ Add New State</h3>
      <form action="/admin/locations/state" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="state_name_input">State Name *</label>
          <input type="text" id="state_name_input" name="name" class="form-control" placeholder="e.g. Maharashtra, Goa" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="state_code_input">State Code (Optional)</label>
          <input type="text" id="state_code_input" name="code" class="form-control" placeholder="e.g. MH, GA">
        </div>
        <button type="submit" class="btn btn-primary btn-sm" style="width: 100%;">Create State</button>
      </form>
    </div>

    <!-- Add District Form -->
    <div style="background-color: var(--color-zumthor); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(0, 0, 0, 0.08);">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-black);">+ Add New District</h3>
      <form action="/admin/locations/district" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="district_state_select">Select State *</label>
          <select id="district_state_select" name="state_id" class="form-control" required>
            <option value="">-- Choose Parent State --</option>
            <% states.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="district_name_input">District Name *</label>
          <input type="text" id="district_name_input" name="name" class="form-control" placeholder="e.g. Madurai, Salem" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="district_code_input">District Code (Optional)</label>
          <input type="text" id="district_code_input" name="code" class="form-control" placeholder="e.g. MDU, SLM">
        </div>
        <button type="submit" class="btn btn-primary btn-sm" style="width: 100%;">Create District</button>
      </form>
    </div>

    <!-- Add Unit Form -->
    <div style="background-color: var(--color-zumthor); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(0, 0, 0, 0.08);">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-black);">+ Add New Unit</h3>
      <form action="/admin/locations/unit" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="unit_district_select">Select District *</label>
          <select id="unit_district_select" name="district_id" class="form-control" required>
            <option value="">-- Choose Parent District --</option>
            <% states.forEach(s => { %>
              <% const stateDistricts = districts.filter(d => d.state_id === s.id); %>
              <% if (stateDistricts.length > 0) { %>
                <optgroup label="<%= s.name %>">
                  <% stateDistricts.forEach(d => { %>
                    <option value="<%= d.id %>"><%= d.name %></option>
                  <% }); %>
                </optgroup>
              <% } %>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="unit_name_input">Unit Name *</label>
          <input type="text" id="unit_name_input" name="name" class="form-control" placeholder="e.g. Ward 10, Zone B" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="unit_code_input">Unit Code (Optional)</label>
          <input type="text" id="unit_code_input" name="code" class="form-control" placeholder="e.g. W10, ZNB">
        </div>
        <button type="submit" class="btn btn-primary btn-sm" style="width: 100%;">Create Unit</button>
      </form>
    </div>

  </div>

  <!-- Location Hierarchy Tree Display -->
  <div>
    <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1rem; border-bottom: 2px solid var(--color-zumthor); padding-bottom: 0.5rem;">
      Existing State → District → Unit Hierarchy Tree
    </h2>

    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% tree.forEach(state => { %>
        <div style="border: 1.5px solid rgba(0, 0, 0, 0.08); border-radius: var(--radius-md); padding: 1.25rem; background: var(--color-white);">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
            <span class="badge" style="background-color: var(--color-black); color: var(--color-white); font-size: 1rem; padding: 0.4rem 0.8rem;">
              🏛️ State: <%= state.name %> (<%= state.code %>)
            </span>
            <span style="font-size: 0.85rem; color: var(--color-mid-gray);"><%= state.districts.length %> District<%= state.districts.length === 1 ? '' : 's' %></span>
          </div>

          <% if (state.districts.length === 0) { %>
            <p style="font-size: 0.85rem; color: var(--color-mid-gray); font-style: italic; margin-left: 1rem;">No districts created for this state yet.</p>
          <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-left: 1rem;">
              <% state.districts.forEach(dist => { %>
                <div style="background-color: var(--color-zumthor); padding: 1rem; border-radius: var(--radius-md); border: 1px solid rgba(0, 0, 0, 0.06);">
                  <div style="font-weight: 800; color: #000000; margin-bottom: 0.5rem;">
                    📍 District: <%= dist.name %> (<%= dist.code %>)
                  </div>
                  <% if (dist.units.length === 0) { %>
                    <p style="font-size: 0.8rem; color: var(--color-mid-gray); font-style: italic;">No units created yet.</p>
                  <% } else { %>
                    <ul style="list-style: none; padding-left: 0; margin: 0; font-size: 0.85rem; color: var(--color-black);">
                      <% dist.units.forEach(u => { %>
                        <li style="padding: 0.25rem 0; border-bottom: 1px dashed rgba(0, 0, 0, 0.12); display: flex; justify-content: space-between;">
                          <span>🏢 <%= u.name %></span>
                          <span style="font-family: monospace; color: var(--color-primary); font-weight: 700;"><%= u.code %></span>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
