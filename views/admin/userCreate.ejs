<%- include('../partials/header') %>

<div class="card" style="max-width: 800px; margin: 2rem auto;">
  <div class="card-header">
    <div>
      <h1 class="card-title">Create User Account</h1>
      <p style="font-size: 0.9rem; color: var(--color-mid-gray);">Admin user creation flow for Unit, District, and State hierarchy levels</p>
    </div>
    <a href="/admin/users" class="btn btn-outline btn-sm">← Back to Users List</a>
  </div>

  <form action="/admin/users/create" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="username">Username (Field #1) *</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="e.g. jdoe_unit" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Email Address (Field #2) *</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="user@domain.org" required>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="contact_no">Contact Number (Field #3) *</label>
        <input type="tel" id="contact_no" name="contact_no" class="form-control" placeholder="10-digit phone number" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="secondary_no">Secondary Number (Field #4)</label>
        <input type="tel" id="secondary_no" name="secondary_no" class="form-control" placeholder="Optional alternate number">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="contact_address">Contact Address (Field #5) *</label>
      <input type="text" id="contact_address" name="contact_address" class="form-control" placeholder="Full primary address" required>
    </div>

    <div class="form-group">
      <label class="form-label" for="secondary_address">Secondary Address (Field #6)</label>
      <input type="text" id="secondary_address" name="secondary_address" class="form-control" placeholder="Optional secondary address">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="aadhaar">Aadhaar Number (Field #7 - Encrypted at Rest) *</label>
        <input type="text" id="aadhaar" name="aadhaar" class="form-control" placeholder="12-digit Aadhaar number" maxlength="12" pattern="\d{12}" title="12-digit numeric Aadhaar" required>
        <p style="font-size: 0.75rem; color: var(--color-mid-gray); margin-top: 0.25rem;">Stored securely in the database using AES-256-GCM encryption at rest.</p>
      </div>

      <div class="form-group">
        <label class="form-label">UserNo (Field #8)</label>
        <input type="text" class="form-control" value="Auto-Generated by Server (e.g. USR-1004)" disabled style="background-color: var(--color-zumthor); font-weight: 700;">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="password">Password (Field #9 - Hashed via Bcrypt) *</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Minimum 8 characters" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="unit_type">Unit Type (Field #10) *</label>
        <select id="unit_type" name="unit_type" class="form-control" required>
          <option value="unit">Unit Level</option>
          <option value="district">District Level</option>
          <option value="state">State Level</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="state_name">State Name *</label>
        <select id="state_name" name="state_name" class="form-control" required onchange="onStateSelectChange(this.value)">
          <% (typeof states !== 'undefined' ? states : []).forEach(s => { %>
            <option value="<%= s.name %>"><%= s.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="district_name">District Name *</label>
        <select id="district_name" name="district_name" class="form-control" required onchange="onDistrictSelectChange(this.value)">
          <% (typeof districts !== 'undefined' ? districts : []).forEach(d => { %>
            <option value="<%= d.name %>"><%= d.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="unit_name">Unit Name *</label>
        <select id="unit_name" name="unit_name" class="form-control" required>
          <% (typeof units !== 'undefined' ? units : []).forEach(u => { %>
            <option value="<%= u.name %>"><%= u.name %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label" for="status">Initial Account Status (Field #11) *</label>
        <select id="status" name="status" class="form-control" required>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="is_admin">Grant Admin Dashboard Access</label>
        <select id="is_admin" name="is_admin" class="form-control">
          <option value="0">No - Standard User</option>
          <option value="1">Yes - Admin User</option>
        </select>
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
      <a href="/admin/users" class="btn btn-outline">Cancel</a>
      <button type="submit" class="btn btn-primary">Create User Account</button>
    </div>
  </form>
</div>

<script>
  const locationTree = <%- JSON.stringify(typeof tree !== 'undefined' ? tree : []) %>;

  function onStateSelectChange(selectedStateName) {
    const districtSelect = document.getElementById('district_name');
    const unitSelect = document.getElementById('unit_name');
    if (!districtSelect || !unitSelect) return;

    districtSelect.innerHTML = '';
    unitSelect.innerHTML = '';

    const stateObj = locationTree.find(s => s.name === selectedStateName);
    if (stateObj && stateObj.districts && stateObj.districts.length > 0) {
      stateObj.districts.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d.name;
        opt.textContent = d.name;
        districtSelect.appendChild(opt);
      });

      if (stateObj.districts[0]) {
        districtSelect.value = stateObj.districts[0].name;
      }

      onDistrictSelectChange(districtSelect.value);
    } else {
      const defaultDist = document.createElement('option');
      defaultDist.value = '';
      defaultDist.textContent = 'No districts available';
      districtSelect.appendChild(defaultDist);

      const defaultUnit = document.createElement('option');
      defaultUnit.value = '';
      defaultUnit.textContent = 'No units available';
      unitSelect.appendChild(defaultUnit);
    }
  }

  function onDistrictSelectChange(selectedDistrictName) {
    const stateSelect = document.getElementById('state_name');
    const unitSelect = document.getElementById('unit_name');
    if (!stateSelect || !unitSelect) return;

    unitSelect.innerHTML = '';

    const stateObj = locationTree.find(s => s.name === stateSelect.value);
    const districtObj = stateObj?.districts?.find(d => d.name === selectedDistrictName);

    if (districtObj && districtObj.units && districtObj.units.length > 0) {
      districtObj.units.forEach(u => {
        const opt = document.createElement('option');
        opt.value = u.name;
        opt.textContent = u.name;
        unitSelect.appendChild(opt);
      });

      if (districtObj.units[0]) {
        unitSelect.value = districtObj.units[0].name;
      }
    } else {
      const defaultUnit = document.createElement('option');
      defaultUnit.value = '';
      defaultUnit.textContent = 'No units available';
      unitSelect.appendChild(defaultUnit);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const stateSelect = document.getElementById('state_name');
    if (stateSelect && stateSelect.value) {
      onStateSelectChange(stateSelect.value);
    }
  });
</script>

<%- include('../partials/footer') %>
