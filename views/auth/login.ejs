<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>
    <%= title %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap"
    rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/images/ssf-logo.svg">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Full-Page Edge-to-Edge Portal Styles */
    html,
    body {
      margin: 0;
      padding: 0;
      width: 100vw;
      min-height: 100vh;
      overflow-x: hidden;
      background: #000000;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: #000000;
    }

    .portal-root {
      display: flex;
      width: 100vw;
      min-height: 100vh;
      margin: 0;
      padding: 0;
    }

    /* Left Panel: The Obsidian Citadel */
    .portal-citadel {
      flex: 1.15;
      background: radial-gradient(circle at 18% 22%, rgba(58, 182, 72, 0.22) 0%, #000000 70%);
      color: #FFFFFF;
      padding: clamp(2.5rem, 5vw, 4.5rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: 1.5px solid rgba(58, 182, 72, 0.35);
      position: relative;
      overflow: hidden;
    }

    .portal-citadel::before {
      content: '';
      position: absolute;
      bottom: -15%;
      left: -10%;
      width: 450px;
      height: 450px;
      background: radial-gradient(circle, rgba(58, 182, 72, 0.12) 0%, transparent 70%);
      pointer-events: none;
    }

    .citadel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      z-index: 2;
    }

    .citadel-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(1.4rem, 2.5vw, 1.85rem);
      font-weight: 900;
      letter-spacing: -0.5px;
      color: #FFFFFF;
      text-decoration: none;
    }

    .brand-logo-img {
      width: 44px;
      height: 44px;
      background: #FFFFFF;
      border: 2px solid #3AB648;
      border-radius: 12px;
      padding: 3px;
      box-shadow: 0 0 18px rgba(58, 182, 72, 0.45);
      object-fit: contain;
      display: inline-block;
      flex-shrink: 0;
    }

    .brand-icon-emblem {
      width: 42px;
      height: 42px;
      background: #000000;
      border: 2px solid #3AB648;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #3AB648;
      font-size: 1.3rem;
      font-weight: 900;
      box-shadow: 0 0 16px rgba(58, 182, 72, 0.4);
    }

    .brand-accent-green {
      color: #3AB648;
    }

    .citadel-tier-pill {
      background: #3AB648;
      color: #FFFFFF;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.3rem 0.75rem;
      border-radius: 9999px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      box-shadow: 0 2px 10px rgba(58, 182, 72, 0.35);
    }

    .citadel-flag-showcase {
      margin: 1.5rem 0 2rem 0;
      display: flex;
      justify-content: flex-start;
    }

    .flag-wrapper {
      position: relative;
      max-width: 460px;
      width: 100%;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.04);
      border: 1.5px solid rgba(58, 182, 72, 0.45);
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.75), 0 0 25px rgba(58, 182, 72, 0.2);
      overflow: hidden;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .flag-wrapper:hover {
      transform: translateY(-3px);
      border-color: #3AB648;
      box-shadow: 0 25px 55px rgba(0, 0, 0, 0.85), 0 0 35px rgba(58, 182, 72, 0.35);
    }

    .ssf-flag-img {
      width: 100%;
      height: auto;
      max-height: 250px;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      display: block;
    }

    .flag-caption {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.65rem 1.15rem;
      background: rgba(0, 0, 0, 0.85);
      border-top: 1px solid rgba(58, 182, 72, 0.3);
      font-size: 0.76rem;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: 0.6px;
      text-transform: uppercase;
    }

    .flag-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #3AB648;
      box-shadow: 0 0 8px #3AB648;
    }

    .citadel-hero-content {
      margin: 2.5rem 0;
      z-index: 2;
    }

    .citadel-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(58, 182, 72, 0.12);
      border: 1px solid #3AB648;
      color: #3AB648;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      margin-bottom: 1.25rem;
      letter-spacing: 0.5px;
    }

    .citadel-headline {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(2.2rem, 4vw, 3.25rem);
      font-weight: 900;
      line-height: 1.15;
      color: #FFFFFF;
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
    }

    .citadel-subline {
      color: rgba(255, 255, 255, 0.82);
      font-size: clamp(0.98rem, 1.4vw, 1.12rem);
      line-height: 1.65;
      max-width: 580px;
      margin-bottom: 2.5rem;
    }

    .citadel-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.25rem;
      max-width: 620px;
    }

    .citadel-metric-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(58, 182, 72, 0.25);
      border-radius: 14px;
      padding: 1.2rem;
      transition: all 0.25s ease;
    }

    .citadel-metric-card:hover {
      background: rgba(58, 182, 72, 0.08);
      border-color: #3AB648;
      transform: translateY(-2px);
    }

    .metric-icon {
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
      display: inline-block;
    }

    .metric-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 0.25rem;
    }

    .metric-desc {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.45;
    }

    .citadel-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.65);
      z-index: 2;
    }

    .status-live-beacon {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      color: #FFFFFF;
      font-weight: 600;
    }

    .beacon-pulse {
      width: 10px;
      height: 10px;
      background: #3AB648;
      border-radius: 50%;
      box-shadow: 0 0 10px #3AB648;
      animation: pulseGlow 1.8s infinite;
    }

    @keyframes pulseGlow {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.5;
        transform: scale(0.85);
      }
    }

    /* Right Panel: The Executive Auth Chamber */
    .portal-chamber {
      flex: 1;
      background: #EFF6FF;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(2rem, 5vw, 4.5rem);
      position: relative;
    }

    .chamber-card {
      width: 100%;
      max-width: 520px;
      background: #FFFFFF;
      border: 1.5px solid rgba(0, 0, 0, 0.08);
      border-radius: 20px;
      padding: clamp(2.25rem, 4vw, 3.25rem);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.07);
    }

    .chamber-header {
      margin-bottom: 2rem;
      text-align: left;
    }

    .chamber-title {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(1.75rem, 2.5vw, 2.2rem);
      font-weight: 900;
      color: #000000;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    .chamber-subtitle {
      color: rgba(0, 0, 0, 0.65);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* Input Field Styling */
    .input-field-wrapper {
      margin-bottom: 1.35rem;
    }

    .input-icon-prefix {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      font-size: 1.1rem;
      opacity: 0.75;
    }

    .portal-input {
      width: 100%;
      padding: 0.95rem 1rem 0.95rem 2.9rem;
      border: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 12px;
      background: #EFF6FF;
      color: #000000;
      font-size: 0.96rem;
      font-family: inherit;
      font-weight: 500;
      transition: all 0.25s ease;
      box-sizing: border-box;
    }

    .portal-input:focus {
      outline: none;
      background: #FFFFFF;
      border-color: #3AB648;
      box-shadow: 0 0 0 4px rgba(58, 182, 72, 0.25);
    }

    .portal-input::placeholder {
      color: rgba(0, 0, 0, 0.45);
    }

    /* Password Show/Hide Toggle */
    .pwd-toggle-btn {
      position: absolute;
      right: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #000000;
      cursor: pointer;
      padding: 0.4rem;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      opacity: 0.65;
    }

    .pwd-toggle-btn:hover {
      opacity: 1;
      background: rgba(0, 0, 0, 0.05);
    }

    /* Submit CTA */
    .portal-submit-btn {
      width: 100%;
      padding: 1rem 1.5rem;
      background: #3AB648;
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      font-family: 'Outfit', sans-serif;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 0.2px;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(58, 182, 72, 0.35);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      margin-top: 1.75rem;
    }

    .portal-submit-btn:hover {
      filter: brightness(0.92);
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(58, 182, 72, 0.45);
    }

    .portal-submit-btn:active {
      transform: translateY(0);
    }

    /* Footnote Security Badge */
    .chamber-footnote {
      margin-top: 1.85rem;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      background: #EFF6FF;
      border: 1px solid rgba(58, 182, 72, 0.3);
      font-size: 0.82rem;
      color: #000000;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-weight: 600;
    }

    /* Responsive Adaptation for Mobile: Show ONLY right side of login page */
    @media (max-width: 960px) {
      .portal-root {
        flex-direction: column;
        min-height: 100vh;
      }

      /* Hide left panel entirely on mobile */
      .portal-citadel {
        display: none !important;
      }

      /* Show only right chamber full-page on mobile */
      .portal-chamber {
        flex: 1;
        width: 100vw;
        min-height: 100vh;
        padding: 2rem 1.25rem;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .chamber-card {
        max-width: 480px;
        width: 100%;
        padding: 2.25rem 1.5rem;
      }
    }
  </style>
</head>

<body>
  <%- include('../partials/loader') %>

    <div class="portal-root">
      <!-- Left Citadel: Official SSF Standard & Tamil Nadu State Values (Desktop only) -->
      <aside class="portal-citadel">
        <div class="citadel-header">
          <a href="/" class="citadel-brand">
            <img src="/images/ssf-logo.svg" alt="SSF Institutional Logo" class="brand-logo-img">
            <div>SSF <span class="brand-accent-green">Tamil Nadu</span></div>
          </a>
          <span class="citadel-tier-pill">STATE PORTAL</span>
        </div>

        <div class="citadel-hero-content">
          <!-- Prominent High-Clarity SSF Flag Showcase -->
          <div class="citadel-flag-showcase">
            <div class="flag-wrapper">
              <img src="/images/ssf-flag.svg" alt="Official SSF Flag" class="ssf-flag-img">
              <div class="flag-caption">
                <span class="flag-dot"></span>
                <span>Official SSF Standard &bull; Sunni Students' Federation</span>
              </div>
            </div>
          </div>

          <h1 class="citadel-headline">
            Sunni Students' Federation <span class="brand-accent-green">Tamil Nadu</span>
          </h1>
          <p class="citadel-subline">
            Empowering the student community through moral revolution, educational guidance, and active civic
            participation across Tamil Nadu.
          </p>

          <!-- Core Value Highlights of SSF Tamil Nadu -->
          <div class="citadel-metrics-grid">
            <div class="citadel-metric-card">
              <div class="metric-icon">🎓</div>
              <div class="metric-title">Moral &amp; Academic Excellence</div>
              <div class="metric-desc">Guiding students across school, campus, and university units with moral
                leadership, ethical values, and higher educational support.</div>
            </div>
            <div class="citadel-metric-card">
              <div class="metric-icon">📍</div>
              <div class="metric-title">State-Wide District Federation</div>
              <div class="metric-desc">Active institutional network spanning 38 districts across Tamil Nadu—connecting
                Chennai, Madurai, Coimbatore, Tirunelveli, and rural units.</div>
            </div>
          </div>
        </div>

        <div class="citadel-footer">
          <div class="status-live-beacon">
            <span class="beacon-pulse"></span>
            <span>SSF Tamil Nadu State Committee &bull; Official Portal</span>
          </div>
          <div>Verified Institutional Registry</div>
        </div>
      </aside>

      <!-- Right Chamber: Executive Authentication -->
      <main class="portal-chamber">
        <div class="chamber-card">
          <div class="chamber-header">
            <div style="display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.25rem;">
              <img src="/images/ssf-logo.svg" alt="SSF Logo" width="46" height="46"
                style="background: #FFFFFF; border-radius: 12px; padding: 3px; border: 2px solid #3AB648; box-shadow: 0 4px 14px rgba(58, 182, 72, 0.25);">
              <div>
                <div
                  style="font-family: 'Outfit', sans-serif; font-size: 1.15rem; font-weight: 800; color: #000000; letter-spacing: -0.3px;">
                  SSF Event Record</div>
                <div
                  style="font-size: 0.72rem; color: rgba(0, 0, 0, 0.6); font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px;">
                  National Provenance Vault</div>
              </div>
            </div>
            <h2 class="chamber-title">Sign In to Portal</h2>
            <p class="chamber-subtitle">Authenticate with your institutional credentials to access your designated
              operational jurisdiction.</p>
          </div>

          <%- include('../partials/alerts') %>

            <form action="/login" method="POST" id="login-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="input-field-wrapper">
                <label class="form-label" for="username">Institutional Username</label>
                <div style="position: relative;">
                  <span class="input-icon-prefix" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </span>
                  <input type="text" id="username" name="username" class="portal-input"
                    placeholder="Enter username (e.g. admin)" required autofocus autocomplete="username">
                </div>
              </div>

              <div class="input-field-wrapper">
                <label class="form-label" for="password">Access Password</label>
                <div style="position: relative;">
                  <span class="input-icon-prefix" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  </span>
                  <input type="password" id="password" name="password" class="portal-input" placeholder="Enter password"
                    required autocomplete="current-password" style="padding-right: 2.85rem;">
                  <button type="button" class="pwd-toggle-btn" id="pwd-toggle-btn"
                    aria-label="Toggle password visibility" title="Toggle password visibility">
                    <svg id="eye-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="eye-icon-closed" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      style="display: none;">
                      <path
                        d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24">
                      </path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>
                </div>
              </div>

              <button type="submit" class="portal-submit-btn">
                <span>Authenticate Session</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </form>

            <div class="chamber-footnote">
              <span style="color: #3AB648;">🛡️</span> Protected by Active CSRF &amp; Rate-Limit Shields
            </div>
        </div>
      </main>
    </div>

    <script src="/js/app.js"></script>
    <script>
      // Interactive Password Show/Hide Toggle
      document.addEventListener('DOMContentLoaded', () => {
        const pwdInput = document.getElementById('password');
        const toggleBtn = document.getElementById('pwd-toggle-btn');
        const eyeOpen = document.getElementById('eye-icon-open');
        const eyeClosed = document.getElementById('eye-icon-closed');

        if (toggleBtn && pwdInput) {
          toggleBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const isPassword = pwdInput.type === 'password';
            pwdInput.type = isPassword ? 'text' : 'password';
            eyeOpen.style.display = isPassword ? 'none' : 'block';
            eyeClosed.style.display = isPassword ? 'block' : 'none';
            pwdInput.focus();
          });
        }
      });
    </script>
</body>

</html>