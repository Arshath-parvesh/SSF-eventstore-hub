<%- include('../partials/header') %>

<div class="card">
  <div class="card-header">
    <div>
      <h1 class="card-title">Event Records</h1>
      <p style="font-size: 0.9rem; color: #4b5563;">View and manage event records across Unit, District, and State levels</p>
    </div>
    <a href="/events/create" class="btn btn-primary">+ Post New Event</a>
  </div>

  <!-- Filters Form -->
  <form method="GET" action="/events" style="margin-bottom: 1.5rem;" data-no-loader="true">
    <div class="form-row" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filter by Hierarchy Level</label>
        <select name="unit_type" class="form-control" onchange="this.form.submit()">
          <option value="">All Levels (Unit, District, State)</option>
          <option value="unit" <%= filters.unit_type === 'unit' ? 'selected' : '' %>>Unit Level</option>
          <option value="district" <%= filters.unit_type === 'district' ? 'selected' : '' %>>District Level</option>
          <option value="state" <%= filters.unit_type === 'state' ? 'selected' : '' %>>State Level</option>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filter by State</label>
        <select name="state_name" class="form-control" onchange="this.form.submit()">
          <option value="">All States</option>
          <% (typeof states !== 'undefined' ? states : []).forEach(s => { %>
            <option value="<%= s.name %>" <%= filters.state_name === s.name ? 'selected' : '' %>><%= s.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filter by District</label>
        <select name="district_name" class="form-control" onchange="this.form.submit()">
          <option value="">All Districts</option>
          <% (typeof districts !== 'undefined' ? districts : []).forEach(d => { %>
            <option value="<%= d.name %>" <%= filters.district_name === d.name ? 'selected' : '' %>><%= d.state_name %> → <%= d.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filter by Category</label>
        <select name="category" class="form-control" onchange="this.form.submit()">
          <option value="">All Categories</option>
          <option value="Health" <%= filters.category === 'Health' ? 'selected' : '' %>>Health</option>
          <option value="Environment" <%= filters.category === 'Environment' ? 'selected' : '' %>>Environment</option>
          <option value="Culture" <%= filters.category === 'Culture' ? 'selected' : '' %>>Culture</option>
          <option value="Community" <%= filters.category === 'Community' ? 'selected' : '' %>>Community</option>
          <option value="Conference" <%= filters.category === 'Conference' ? 'selected' : '' %>>Conference</option>
          <option value="Awards" <%= filters.category === 'Awards' ? 'selected' : '' %>>Awards</option>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filter by Event Date</label>
        <input type="date" name="event_date" class="form-control" value="<%= filters.event_date || '' %>" onchange="this.form.submit()">
      </div>
    </div>
  </form>

  <% if (records.length === 0) { %>
    <div style="text-align: center; padding: 3rem; background-color: var(--color-zumthor); border-radius: var(--radius-md);">
      <h3>No Event Records Found</h3>
      <p style="color: #6b7280; margin-top: 0.5rem;">There are no event posts matching your filter criteria.</p>
    </div>
  <% } else { %>
    <div class="event-grid">
      <% records.forEach(record => { %>
        <div class="event-card">
          <% if (record.cover_image_id) { %>
            <img src="/events/images/<%= record.cover_image_id %>" alt="<%= record.title %>" class="event-card-img" loading="lazy">
          <% } else { %>
            <div class="event-card-img" style="display: flex; align-items: center; justify-content: center; font-weight: 700; color: #9ca3af;">
              No Image Data
            </div>
          <% } %>

          <div class="event-card-body">
            <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
              <span class="badge badge-<%= record.unit_type %>"><%= record.unit_type %></span>
              <span class="badge" style="background-color: var(--color-black); color: var(--color-white);"><%= record.state_name || 'Tamil Nadu' %></span>
              <span class="badge" style="background-color: #3b82f6; color: var(--color-white);"><%= record.district_name || 'Chennai' %></span>
              <span class="badge" style="background-color: var(--color-apple-green); color: var(--color-white);"><%= record.unit_name || 'Sholinganallur' %></span>
              <span style="font-size: 0.75rem; color: #6b7280; font-weight: 600;">ID: <%= record.record_id %></span>
            </div>

            <h3 class="event-card-title"><%= record.title %></h3>

            <div class="event-card-meta">
              <span>📅 Date: <strong><%= record.event_date %></strong></span>
              <span>👤 Creator: <strong><%= record.user_no %></strong></span>
              <span>🖼️ Images: <strong><%= record.image_count %></strong></span>
            </div>

            <div style="margin-bottom: 1rem;">
              <% record.categories.forEach(cat => { %>
                <span class="badge" style="background-color: var(--color-zumthor); color: var(--color-black); border: 1px solid #d1d5db; margin-right: 0.25rem;"><%= cat %></span>
              <% }); %>
            </div>

            <div class="event-card-footer">
              <a href="/events/<%= record.record_id %>" class="btn btn-primary btn-sm" data-loader="true">View Details & Gallery</a>

              <!-- Server-Side Permission Rule Check for UI: Show delete ONLY if owner or admin -->
              <% if (currentUser.is_admin || record.user_no === currentUser.user_no) { %>
                <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete('<%= record.record_id %>', '/events/<%= record.record_id %>/delete')">
                  Delete
                </button>
              <% } else { %>
                <span style="font-size: 0.75rem; color: #9ca3af; font-style: italic;">View-Only</span>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/deleteModal') %>
<%- include('../partials/footer') %>
